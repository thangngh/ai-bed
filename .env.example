# Root compose settings. Copy to .env (gitignored) and fill in.
#
#   cp .env.example .env

# The only published host port. The Engine and the BE are reachable by service
# name inside the compose network and nowhere else: a published 8000 or 3001 is
# a way around nginx's per-IP rate limit and the BE's per-tenant one, straight
# onto the LLM budget.
FRONTEND_PORT=80

# Shared secret the BE sends to the Engine as X-Engine-Key. Second lock behind
# the closed port: without it, anything else that lands on the compose network
# can call /generate. The Engine only enforces it when set, so leaving it empty
# keeps `python main.py` working locally.
# Generate: node -e console.log(require('crypto').randomBytes(32).toString('base64url'))
ENGINE_API_KEY=

# --- 9router HA overlay (docker-compose.9router-ha.yml) ----------------------
# Each replica mints its own API keys, and a key from one replica is 401 on
# the other, so the balancer injects the matching key per replica. Get them
# from a bootstrapped stack:
#
#   docker compose -f docker-compose.yml -f docker-compose.9router-ha.yml up -d 9router-a 9router-b
#   node scripts/bootstrap-9router.mjs
#
# 9router only reveals a key's secret at creation time. If the script reports
# that a key named "ai-bedtime-engine" already exists, delete it in that
# replica's dashboard and run the script again.
NINEROUTER_KEY_A=
NINEROUTER_KEY_B=

# Dashboard password, applied only on first init of a replica's volume. There
# is deliberately no default: the compose file uses `:?` and refuses to start
# without it. This used to fall back to a password written in the repo, which
# meant a forgotten variable produced a stack whose dashboard -- and the
# provider API keys behind it -- opened with a value anyone could read here.
# Generate: node -e console.log(require('crypto').randomBytes(24).toString('base64url'))
NINEROUTER_PASSWORD=

# Host port for the balancer. Not 20128: that is where a locally-installed
# 9router listens.
NINEROUTER_LB_PORT=20127

# Cloudflare Tunnel -- named tunnel, profile-gated (off by default):
#
#   docker compose -f docker-compose.yml -f docker-compose.9router-ha.yml \
#     --profile cloudflared up -d cloudflared
#
# The JWT comes from the Cloudflare Tunnel dashboard (free tier; it lives under
# the Zero Trust UI but is not a billed add-on). Its ingress rules are remote:
# point the tunnel's hostname at http://9router-lb:20128 there, not here.
# Verified connected 2026-08-05 (4 QUIC connections registered) -- an empty
# ingress binding is what makes a token fail with `control stream encountered a
# failure`, see docs/11.
#
# INGRESS only (exposes the HA balancer behind the edge; IP obscuration, WAF,
# caching). It does NOT rotate the replicas egress to DeepSeek/OpenRouter --
# that needs REPLICA_A/B_PROXY or a paid key.
CLOUDFLARE_TUNNEL_TOKEN=

# Distinct outbound proxies, if you have them. Without these all replicas
# share the host's egress IP -- see the header of the HA compose file.
REPLICA_A_PROXY=
REPLICA_B_PROXY=

# --- Engine tuning ----------------------------------------------------------
# Provider order, most-preferred first. Names: openai, gemini, custom (the
# 9router HA balancer), deepseek, openrouter. Unset keeps the registration
# order. The 24/7 default puts the 9router HA balancer first, DeepSeek second,
# then the hosted fallbacks. Names without credentials are skipped, so deepseek
# is harmless when DEEPSEEK_API_KEY is unset.
# Production fallback order: deepseek (paid) -> openrouter (free, 2-3 keys)
# -> custom (9router HA). Names without credentials are skipped.
LLM_CHAIN=deepseek,openrouter,custom

# Round-robin the *entry point* into that chain instead of always starting at
# the head, so N providers each carry about 1/N of the calls. The order is
# rotated, never shortened: every provider is still a fallback for the others.
#
# Worth turning on when the providers can all actually serve -- it is what
# stops one free tier absorbing every request until it hits its daily cap.
# Leave it off when one provider is clearly better or slower than the rest,
# because entering at the worse one costs its full latency on every 1/N calls.
# LLM_ROTATE=true

# The custom provider asks for `stream: true` by default. This is not about
# speed -- streamed and buffered runs of the same writer prompt averaged 33.2s
# and 35.3s -- it is about being able to tell a slow call from a dead one. A
# buffered request says nothing for its whole duration (measured silences of
# 26-40s), so the only safe timeout is one sized for the worst generation, and
# a provider that has died still costs the full 300s before the router falls
# back. A stream keeps arriving every 1-2s, including while the model is only
# reasoning, so 60s of silence is unambiguous.
#
# A proxy that ignores `stream: true` and answers with one buffered object
# still works -- the client parses both. Turn this off only for a proxy that
# rejects the flag outright.
# CUSTOM_LLM_STREAM=false
# CUSTOM_LLM_STREAM_IDLE_SECONDS=60

# Send thinking: {type: enabled|disabled} with every custom-provider call.
# Disabled is the default: measured COMPLETE + faster on the free oc/ tier.
# CUSTOM_LLM_THINKING=disabled

# Whole-generation deadline. Keep it below ENGINE_TIMEOUT_MS so a slow run
# returns a fallback story rather than a 502. The HA overlay defaults it to 90
# because the anonymous `oc/` models run ~21s per LLM call.
# PIPELINE_BUDGET_SECONDS=90

# BE's deadline for one Engine call. Must stay above PIPELINE_BUDGET_SECONDS.
# ENGINE_TIMEOUT_MS=120000

# --- Admin console ----------------------------------------------------------
# ADMIN_JWT_SECRET and ADMIN_JWT_TTL_SECONDS belong in BE/.env, not here. This
# file is only read by compose for ${VAR} substitution, and the backend service
# does not pass those two through -- setting them here would look configured
# and reach nothing, while the BE crash-loops on a missing secret. See
# BE/.env.example.
