ENGINE_PORT=8000

# Whole-generation deadline. Must stay comfortably below BE's
# ENGINE_TIMEOUT_MS so a slow run returns a fallback story rather than a 502.
PIPELINE_BUDGET_SECONDS=45

# Providers are tried in this order: openai -> gemini -> custom -> openrouter.
# A provider is only registered if its credentials are present, and is dropped
# at startup if its health check fails.
PRIMARY_LLM=openai
OPENAI_API_KEYS=sk-key1,sk-key2,sk-key3,sk-key4
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

FALLBACK_LLM=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Local OpenAI-compatible proxy (9router). Leave CUSTOM_LLM_URL empty to
# disable this provider entirely.
CUSTOM_LLM_URL=http://localhost:20128/v1/chat/completions
CUSTOM_LLM_API_KEY=
# Pin a concrete backend. Two things this must NOT be:
#   - `opencode`: a 9router combo that round-robins over several models with
#     wildly different latency and quality.
#   - any `oc/...-free` model: those are reasoning models that spend the whole
#     token budget on reasoning and return empty content.
# See docs/09-mvp-latency-spec.md. `ag/` requires an Antigravity connection
# configured in 9router.
CUSTOM_LLM_MODEL=ag/gemini-3-flash-agent
# Reasoning models spend tokens on chain-of-thought before any content, so
# 1024 leaves no room for the story itself.
CUSTOM_LLM_MAX_TOKENS=4096
CUSTOM_LLM_TEMPERATURE=0.7
# Send thinking: {type: enabled|disabled} with every call. Disabled is the
# 24/7 default (measured faster, COMPLETE output; nemotron 400s with it on);
# proxies that ignore the param are unaffected.
CUSTOM_LLM_THINKING=disabled

# OpenRouter free tier: 2-3 accounts, comma-separated; keys are tried in
# rotation and a key answering 401/429 is disabled for the process after
# 3 failures (OPENROUTER_API_KEY still works as a single key).
OPENROUTER_API_KEYS=
OPENROUTER_API_KEY=

# DeepSeek (OpenAI-compatible, https://api.deepseek.com). Registered after
# `custom` in the chain. DEEPSEEK_BASE_URL can point at a local
# OpenAI-compatible proxy -- e.g. 9router's `deepsteak` combo -- instead of
# the hosted API.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# deepseek-reasoner spends tokens on chain-of-thought before any content;
# keep the budget at 4096+ or the story comes back empty, the same failure
# mode as the `oc/*-free` models above.
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7

# 24/7 default chain: the 9router HA balancer first (custom == CUSTOM_LLM_URL),
# then DeepSeek, then the hosted fallbacks. Names that are not configured are
# skipped, so deepseek is harmless without a key.
# Production fallback order: deepsteak (DeepSeek, paid key) first, then
# OpenRouter free (2-3 accounts), then the 9router HA proxy (custom) as
# the last resort. Names without credentials are skipped.
LLM_CHAIN=deepseek,openrouter,custom
# Round-robin the entry point so no single provider absorbs every call until
# it hits its cap. See the note on rotation in the root .env.example.
LLM_ROTATE=true
