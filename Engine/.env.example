ENGINE_PORT=8000
LOG_LEVEL=INFO

# Interactive API docs (/docs, /redoc, /openapi.json). Leave unset: the Engine
# has exactly one caller and it is the BE, so publishing its schema only helps
# whoever else reaches the network. Set to 1/true/yes to turn them on locally.
# ENGINE_DOCS=

# Whole-generation deadline. Must stay comfortably below BE's
# ENGINE_TIMEOUT_MS so a slow run returns a fallback story rather than a 502.
# 120s leaves room for the unchanged planner, writer and safety reviewer when
# using the hosted FPT model, while still bounding retries and provider stalls.
PIPELINE_BUDGET_SECONDS=120

# Providers are tried in this order: openai -> gemini -> custom -> openrouter.
# A provider is only registered if its credentials are present, and is dropped
# at startup if its health check fails.
PRIMARY_LLM=openai
# Comma-separated, and empty by default on purpose: this used to ship the
# literal placeholders sk-key1..sk-key4, which registered OpenAI successfully
# and then put a guaranteed 401 at the head of the fallback chain.
OPENAI_API_KEYS=
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=1024
OPENAI_TEMPERATURE=0.7

FALLBACK_LLM=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# The router sees one provider named `custom`. It owns an ordered adapter chain
# underneath: FPT is active; 9router stays configured but receives no traffic
# until its explicit switch is changed to true.
CUSTOM_LLM_ADAPTERS=fpt,9router

# Paid FPT AI Marketplace adapter (OpenAI-compatible).
CUSTOM_LLM_FPT_ENABLED=true
CUSTOM_LLM_FPT_URL=https://mkp-api.fptcloud.com/chat/completions
CUSTOM_LLM_FPT_API_KEY=
CUSTOM_LLM_FPT_MODEL=DeepSeek-V4-Flash
CUSTOM_LLM_FPT_THINKING=
CUSTOM_LLM_FPT_REASONING_EFFORT=

# Preserved local HA adapter. Disabled means the URL is never contacted. The
# load balancer injects its own replica key, so this adapter key stays empty.
CUSTOM_LLM_9ROUTER_ENABLED=false
CUSTOM_LLM_9ROUTER_URL=http://9router-lb:20128/v1/chat/completions
CUSTOM_LLM_9ROUTER_API_KEY=
CUSTOM_LLM_9ROUTER_MODEL=oc/nemotron-3-ultra-free
CUSTOM_LLM_9ROUTER_TEMPERATURE=0.7
CUSTOM_LLM_9ROUTER_STREAM=true
CUSTOM_LLM_9ROUTER_THINKING=disabled
CUSTOM_LLM_9ROUTER_REASONING_EFFORT=none

# Legacy single-adapter variables remain supported when CUSTOM_LLM_ADAPTERS is
# absent. Do not use them for a new deployment.
CUSTOM_LLM_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
# A ceiling, not prepaid usage. 4096 leaves enough room for the unchanged
# prompt stages that do not provide their own limit.
CUSTOM_LLM_MAX_TOKENS=4096
# Stage ceilings bound abnormal output without shortening any prompt. They are
# deliberately above the expected JSON for each unchanged template: the writer
# gets the largest allowance for its 300-500 word story.
CUSTOM_LLM_PLANNER_MAX_TOKENS=2048
CUSTOM_LLM_WRITER_MAX_TOKENS=3072
CUSTOM_LLM_REVIEWER_MAX_TOKENS=1024
CUSTOM_LLM_MEMORY_MAX_TOKENS=1024
CUSTOM_LLM_TEMPERATURE=0.3
CUSTOM_LLM_STREAM=true
# Legacy single-adapter tuning only. Named adapters use their own fields above.
CUSTOM_LLM_THINKING=
CUSTOM_LLM_REASONING_EFFORT=

# OpenRouter free tier: 2-3 accounts, comma-separated; keys are tried in
# rotation and a key answering 401/429 is disabled for the process after
# 3 failures (OPENROUTER_API_KEY still works as a single key).
OPENROUTER_API_KEYS=
OPENROUTER_API_KEY=
# Free tier. The nemotron/ling free models answer faster but wrap the story in
# reasoning prose that never parses as JSON (measured: 3 writer attempts, 0
# valid). gemma is the free model whose output the validator accepts.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# DeepSeek (OpenAI-compatible, https://api.deepseek.com). Registered after
# `custom` in the chain. DEEPSEEK_BASE_URL can point at a local
# OpenAI-compatible proxy -- e.g. 9router's `deepsteak` combo -- instead of
# the hosted API.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=deepseek-chat
# deepseek-reasoner spends tokens on chain-of-thought before any content;
# keep the budget at 4096+ or the story comes back empty, the same failure
# mode as the `oc/*-free` models above.
DEEPSEEK_MAX_TOKENS=4096
DEEPSEEK_TEMPERATURE=0.7

# Use only the paid custom endpoint. Other providers remain available in code
# but are not entered accidentally when stale credentials exist.
LLM_CHAIN=custom
# Round-robin the entry point so no single provider absorbs every call until
# it hits its cap. See the note on rotation in the root .env.example.
LLM_ROTATE=false

# Memory extraction costs one additional LLM call after every successful
# story. False is the token-saving profile: stored memories are still read,
# but the Engine does not generate new ones automatically. Set true when that
# personalization is worth about 25% more LLM calls per normal story.
MEMORY_EXTRACT_ENABLED=false
# Only used when extraction is enabled; it is best-effort and must not delay a
# finished story for long.
MEMORY_EXTRACT_TIMEOUT_SECONDS=5
