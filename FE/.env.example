# The SPA never talks to an LLM provider directly -- it only calls the BE,
# which owns the Engine call. No model API key belongs in this file.

# BE_PROXY_TARGET: where `vite dev` / `vite preview` forward `/api/*`.
# Build-time only (plain env var, not VITE_*), consumed by vite.config.ts.
# In production nginx.conf does the same job with `proxy_pass http://backend:3001/`.
BE_PROXY_TARGET="http://localhost:3001"

# VITE_BE_URL: set only when the SPA must reach the BE directly instead of
# through the `/api` proxy (e.g. a separately hosted BE). It replaces the whole
# base, so point it at the BE root WITHOUT the `/api` prefix:
#   VITE_BE_URL="https://api.example.com"
# Leave unset for the normal same-origin `/api` setup.
# VITE_BE_URL=

# Public support-payment details embedded in the browser bundle. These are not
# secrets: they are displayed beside the VietQR so parents can verify the
# recipient before transferring. Never put a VietQR API key in a VITE_* value.
VITE_SUPPORT_BANK_BIN=970423
VITE_SUPPORT_BANK_NAME=TPBank
VITE_SUPPORT_ACCOUNT_NUMBER=89325010618
VITE_SUPPORT_ACCOUNT_NAME="NGUYEN DUC THANH"
VITE_SUPPORT_OPERATOR_NAME="Nguyễn Đức Thành"
VITE_SUPPORT_OPERATOR_TYPE="Cá nhân"
VITE_SUPPORT_TAX_CODE=040200004384
VITE_SUPPORT_CONTACT_EMAIL=thanhndptt@gmail.com
VITE_SUPPORT_TRANSFER_CONTENT="UNGHO AIBED"
VITE_SUPPORT_VIETQR_TEMPLATE=compact
