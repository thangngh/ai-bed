# node_modules is rebuilt inside the image. Shipping the host copy would be
# the wrong platform's dependency tree shadowing the one `npm ci` just
# produced inside the container, and the container would fail to start.
node_modules
dist
coverage

# Secrets are supplied at run time via compose `env_file` / `environment`.
.env
.env.*
!.env.example

.git
.gitignore
*.log
