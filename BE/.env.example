PORT=3001
NODE_ENV=development

ENGINE_URL=http://localhost:8000
# Must stay above the Engine's PIPELINE_BUDGET_SECONDS (default 45s) so a slow
# generation comes back as a fallback story rather than a 502 from here.
ENGINE_TIMEOUT_MS=60000
ENGINE_RETRY_COUNT=2

RATE_LIMIT_CAPACITY=10
RATE_LIMIT_REFILL_SECONDS=6

QUEUE_MAX_CONCURRENT=2
QUEUE_MIN_TIME_MS=6000
QUEUE_RESERVOIR=10
QUEUE_RESERVOIR_REFRESH_MS=60000

MEMORY_TTL_DAYS=90
MEMORY_CONFIDENCE_BOOST=0.1
# Must match the Engine setting. False is the token-saving profile: the Engine
# skips the optional fourth LLM call and the BE skips persisting its result.
MEMORY_EXTRACT_ENABLED=false

# --- Admin console ----------------------------------------------------------
# Signs admin session tokens. At least 32 characters, and the BE refuses to
# boot without it -- there is deliberately no default, because a shared default
# secret is how forgeable admin tokens happen.
# Generate: node -e console.log(require('crypto').randomBytes(48).toString('base64url'))
ADMIN_JWT_SECRET=
# How long an admin stays logged in. Default 28800 (8 hours).
ADMIN_JWT_TTL_SECONDS=28800

# --- Parent Google sign-in --------------------------------------------------
# Opt-in: with GOOGLE_CLIENT_ID empty the whole feature reports itself disabled,
# /auth/* answers 404, and the app behaves exactly as it did before. Set it and
# every other variable in this block becomes required -- a half-filled config
# fails at boot rather than at the first parent's login attempt.
#
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type: Web application). Only the redirect URI matters; "Authorized JavaScript
# origins" is unused by a server-side authorization-code flow.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match a redirect URI registered on that OAuth client, byte for byte.
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback
# Where the BE drops the parent afterwards. The access token is appended as a
# URL fragment, which browsers do not send to the server or leak via Referer.
FRONTEND_CALLBACK_URL=http://localhost/auth/callback

# Signs parent access tokens. At least 32 characters. Keep it distinct from
# ADMIN_JWT_SECRET: sharing one secret across two audiences means a single leak
# costs both, even though the `typ` claim keeps the token families apart.
# Generate: node -e console.log(require('crypto').randomBytes(48).toString('base64url'))
PARENT_JWT_SECRET=
# Access token lifetime. Short on purpose -- it is a bearer token the SPA holds
# in memory, and the refresh cookie is what actually keeps the parent signed in.
PARENT_ACCESS_TTL_SECONDS=900
# How long a parent stays signed in without re-authenticating with Google.
PARENT_REFRESH_TTL_DAYS=30
# Cookie Path for the refresh token. The browser matches this against the URL
# it actually requests, which is /api/auth/refresh behind nginx and the vite
# proxy but /auth/refresh when the SPA is pointed straight at the BE via
# VITE_BE_URL. No single narrow value covers both, so the default is `/`;
# narrow it to /api/auth only if you are certain of the deployed path.
PARENT_REFRESH_COOKIE_PATH=/

# --- Optional ---------------------------------------------------------------
# Browser origins allowed to call this API. Empty is correct for the compose
# stack: nginx serves the SPA and proxies /api/ on the same origin, so no
# cross-origin request should ever succeed. Only fill this in when the SPA is
# served from somewhere else.
CORS_ORIGINS=

# Postgres connection string for the `core` datasource (tenants,
# child_profiles, feedbacks, admin_users, dashboard tables). Host-development
# value below assumes `docker compose up -d postgres` with the host port
# bound as set in docker-compose.yml. The compose `backend` service
# itself overrides this to the in-network `postgres:5432` form.
DATABASE_URL=postgresql://ai_bed:<POSTGRES_PASSWORD from your local .env>@localhost:5434/ai_bed
